  "version": 1,
  "annotation_rules": {
    "helpful_progress": "动作必须有当前桌 turn evidence，且对应 expected allowed_actions；自然讨论允许 SILENCE。",
    "high_frequency_interruption": "普通连续 turn 中出现无 evidence 的非 SILENCE，或每轮都插话，标记为干扰。",
    "false_consensus": "单人观点不能进入 clarified/agreement 的全桌共识字段。",
    "cross_table_evidence": "fixture 中不存在的 turn_id 一律判为越桌证据。"
  },
  "scenarios": [
