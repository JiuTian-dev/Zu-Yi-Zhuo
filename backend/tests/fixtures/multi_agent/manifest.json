    {"name":"evidence-boundary","core_question":"试点成功了吗？","participants":[{"participant_id":"p1","display_name":"甲","role":"产品","declared_position":"需要数据"},{"participant_id":"p2","display_name":"乙","role":"工程","declared_position":"正在收集"}],"turns":[{"participant_id":"p1","text":"现在只有两个案例。"},{"participant_id":"p2","text":"还不能说成功。"}],"expected":{"allowed_actions":[],"labels":["evidence"]}},
