    {"name":"silence-default","core_question":"团队如何采用新工具？","participants":[{"participant_id":"p1","display_name":"甲","role":"运营","declared_position":"小步试验"},{"participant_id":"p2","display_name":"乙","role":"研发","declared_position":"观察"}],"turns":[{"participant_id":"p1","text":"先让一组人试用。"},{"participant_id":"p2","text":"我同意先观察数据。"}],"expected":{"allowed_actions":[],"labels":["silence"]}},
    {"name":"pass-underheard","core_question":"谁来补充采购视角？","participants":[{"participant_id":"p1","display_name":"甲","role":"主持人","declared_position":"需要案例"},{"participant_id":"p2","display_name":"乙","role":"采购","declared_position":"需要验收"}],"turns":[{"participant_id":"p1","text":"我先说使用感受。"},{"participant_id":"p1","text":"再补一条体验。"},{"participant_id":"p2","text":"我做过一次供应商验收。"}],"expected":{"allowed_actions":["PASS"],"labels":["pass"]}},
    {"name":"probe-open-loop","core_question":"怎么判断试点有效？","participants":[{"participant_id":"p1","display_name":"甲","role":"产品","declared_position":"看结果"},{"participant_id":"p2","display_name":"乙","role":"研究","declared_position":"看证据"}],"turns":[{"participant_id":"p1","text":"有效性还没有定义。"},{"participant_id":"p2","text":"我们需要一个可比较的指标。"},{"participant_id":"p1","text":"也许要再问成本。"},{"participant_id":"p2","text":"成本与收益怎么比？"}],"expected":{"allowed_actions":["PROBE"],"labels":["probe"]}},
    {"name":"reframe-layer","core_question":"安全和效率如何平衡？","participants":[{"participant_id":"p1","display_name":"甲","role":"安全","declared_position":"先审计"},{"participant_id":"p2","display_name":"乙","role":"业务","declared_position":"先上线"}],"turns":[{"participant_id":"p1","text":"权限边界必须先定义。"},{"participant_id":"p2","text":"但我们讨论的是上线速度。"}],"expected":{"allowed_actions":["REFRAME"],"labels":["reframe"]}},
    {"name":"ground-fact","core_question":"模型精度是否足够？","participants":[{"participant_id":"p1","display_name":"甲","role":"工程","declared_position":"已经够用"},{"participant_id":"p2","display_name":"乙","role":"业务","declared_position":"还不够"}],"turns":[{"participant_id":"p1","text":"模型精度已经支持试点。"},{"participant_id":"p2","text":"模型精度不能用于生产。"}],"expected":{"allowed_actions":["GROUND"],"labels":["fact_conflict"]}},
