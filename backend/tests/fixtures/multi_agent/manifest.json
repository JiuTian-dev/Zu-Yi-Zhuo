    {"name":"close-candidate","core_question":"今天是否可以收桌？","participants":[{"participant_id":"p1","display_name":"甲","role":"产品","declared_position":"形成行动"},{"participant_id":"p2","display_name":"乙","role":"采购","declared_position":"确认责任"}],"turns":[{"participant_id":"p1","text":"行动项已经比较清楚。"},{"participant_id":"p2","text":"责任人也可以确认。"},{"participant_id":"p1","text":"我愿意下周跟进。"}],"expected":{"allowed_actions":["CLOSE"],"labels":["close"]}}
