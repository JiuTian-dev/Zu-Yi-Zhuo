# Copy this file to backend/.env.local before enabling the model-backed run.
# The local file is ignored by git and is loaded by corepack pnpm dev:stack.

CONVERSATION_PROVIDER=openai
OPENAI_API_KEY=
# OpenAI Next Credits exposes Claude through its OpenAI-compatible endpoint.
OPENAI_MODEL=claude-sonnet-4-6
OPENAI_BASE_URL=https://api.openai-next.com/v1
OPENAI_API_STYLE=chat
# Disable hidden reasoning so short host/agent replies are not consumed by thinking tokens.
OPENAI_THINKING=disabled

# Local judge experience: one guest, three simulated peers, one host.
ENABLE_JUDGE_DEMO=1
TABLE_REPOSITORY_PATH=data/judge-demo.json
STAGE_SUMMARY_TIMEOUT_SECONDS=25
