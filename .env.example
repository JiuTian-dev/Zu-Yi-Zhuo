# 只在本地需要用前端种子演示桌时打开；生产环境必须由后端创建桌。
VITE_ALLOW_DEV_SEED=false

# Optional production API origins. Leave blank for Vite's same-origin dev proxy.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Cloudflare Pages Function runtime only. This is a public callback target,
# not a secret; app_key and OAuth tokens stay in the backend secret store.
ZHIHU_OAUTH_BACKEND_CALLBACK_URL=

# 可选：固定视觉验收时的环境时间。
# VITE_DAY_CYCLE_PROGRESS=0.42
# VITE_YEAR_CYCLE_PROGRESS=0.58
